# Where to look
POSTAL_CODE=M5V3L9
COUNTRY=ca
PRODUCT=iphone-duo
# "all", part numbers, or words to match in the model name; comma separated, e.g. "256GB Night Sky, 512GB"
MODELS=all
MAX_DISTANCE_KM=50
INTERVAL_SECONDS=30
# Check faster during these minutes of each hour, e.g. 0-15
FAST_WINDOW=
FAST_INTERVAL_SECONDS=30
# Wait this long after Apple blocks a check (541); you're notified when a block starts and ends
BLOCKED_WAIT_SECONDS=300

# Email via Resend (https://resend.com). Without a verified domain, Resend only delivers to your own account email.
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=

# Optional extra channels
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
